{
  "name": "moment-palette-api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "func start"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "@azure/storage-blob": "12.33.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "azure-functions-core-tools": "4.14.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
