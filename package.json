{
  "name": "moment-palette",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "dev": "vite",
    "metadata:local": "node scripts/generate-build-metadata.mjs --build-id local-development",
    "metadata:ci": "node scripts/generate-build-metadata.mjs --build-id $GITHUB_SHA --production",
    "build": "pnpm metadata:local && pnpm build:prepared",
    "build:prepared": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "preview:swa": "swa start dist --swa-config-location dist --api-devserver-url http://localhost:7071",
    "api:install": "npm --prefix api ci",
    "api:typecheck": "npm --prefix api run typecheck",
    "api:test": "npm --prefix api test",
    "api:build": "npm --prefix api run build",
    "api:start": "npm --prefix api start",
    "metadata:verify": "node scripts/verify-build-metadata.mjs",
    "security:artifacts": "node scripts/check-sensitive-artifacts.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest --watch",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.10",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
