{
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/release.json",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*"]
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
